{
  "compilerOptions": {
    "strict": true,
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "paths": {
      "@rockshin/tao-ui": ["./src/index.tsx"]
    }
  },
  "include": ["src", "docs", "theme", "rspress.config.ts"]
}
