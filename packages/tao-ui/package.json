{
  "name": "@rockshin/tao-ui",
  "version": "0.0.46",
  "type": "module",
  "description": "A modern React component library with semantic DOM customization and OKLCH-based theming.",
  "keywords": [
    "react",
    "react19",
    "react18",
    "component-library",
    "ui",
    "design-system",
    "tao-ui",
    "oklch"
  ],
  "author": "rickyshin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyshin93/tao-ui.git"
  },
  "homepage": "https://rickyshin93.github.io/tao-ui/",
  "bugs": "https://github.com/rickyshin93/tao-ui/issues",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./src/index.tsx",
    "./dist/entries/*.js",
    "./src/entries/*.ts"
  ],
  "exports": {
    "./component-manifest.json": "./component-manifest.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js"
    },
    "./tokens": {
      "types": "./dist/theme/tokens.d.ts",
      "import": "./dist/theme/tokens.js"
    },
    "./locale/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/entries/*.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "component-manifest.json",
    "llms.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "rslib",
    "build:storybook": "storybook build",
    "check": "biome check --write",
    "check:components": "node scripts/check-component-sync.mjs",
    "dev": "rslib --watch",
    "doc": "rspress dev",
    "doc:build": "rspress build && node scripts/build-discovery.mjs",
    "doc:preview": "rspress preview",
    "docs:generate": "node scripts/generate-component-manifest.mjs",
    "docs:check": "node scripts/generate-component-manifest.mjs --check",
    "format": "biome format --write",
    "lint": "biome lint --error-on-warnings src tests stories scripts",
    "release": "bun scripts/release.mjs",
    "storybook": "storybook dev",
    "test": "rstest",
    "test:types": "tsc --noEmit --project tsconfig.type-tests.json && tsc --noEmit --project tsconfig.type-tests.react18.json",
    "test:watch": "rstest --watch",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:package": "bun scripts/check-package-exports.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@rsbuild/core": "^2.2.14",
    "@rsbuild/plugin-babel": "^2.1.0",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rslib/core": "^1.0.3",
    "@rspress/core": "^2.1.0",
    "@rspress/plugin-api-docgen": "^2.1.0",
    "@rspress/plugin-preview": "^2.1.0",
    "@rstest/adapter-rslib": "^0.12.4",
    "@rstest/core": "^0.12.4",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/react": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-dom18": "npm:@types/react-dom@18",
    "@types/react18": "npm:@types/react@18",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "~20.13.2",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dom18": "npm:react-dom@18.2.0",
    "react18": "npm:react@18.2.0",
    "rsbuild-plugin-workspace-dev": "^1.0.0",
    "storybook": "^10.6.2",
    "storybook-addon-rslib": "^3.6.1",
    "storybook-react-rsbuild": "^3.6.1",
    "typescript": "^7.0.2",
    "typescript-compiler": "npm:typescript@6.0.3",
    "zustand": "^5.0.16"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ant-design/react-slick": "~2.0.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-focus-scope": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@rc-component/cascader": "~1.26.0",
    "@rc-component/color-picker": "~3.1.1",
    "@rc-component/form": "~1.8.6",
    "@rc-component/image": "~1.10.0",
    "@rc-component/listy": "~1.4.0",
    "@rc-component/mentions": "~1.14.1",
    "@rc-component/notification": "~2.1.1",
    "@rc-component/pagination": "~1.7.0",
    "@rc-component/picker": "~1.17.0",
    "@rc-component/qrcode": "~2.0.0",
    "@rc-component/rate": "~1.0.1",
    "@rc-component/select": "~1.12.0",
    "@rc-component/slider": "~1.2.1",
    "@rc-component/tabs": "~2.0.0",
    "@rc-component/tour": "~2.4.0",
    "@rc-component/tree": "~1.5.3",
    "@rc-component/tree-select": "~1.19.0",
    "@rc-component/upload": "~1.1.1",
    "@rc-component/util": "1.14.0",
    "dayjs": "^1.11.23",
    "react-compiler-runtime": "^1.0.0",
    "react-remove-scroll": "^2.7.2",
    "scroll-into-view-if-needed": "3.1.0"
  }
}
