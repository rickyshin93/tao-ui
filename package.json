{
  "name": "tao-ui",
  "version": "0.0.1",
  "type": "module",
  "description": "A modern React 19 component library with semantic DOM customization and OKLCH-based theming.",
  "keywords": [
    "react",
    "react19",
    "component-library",
    "ui",
    "design-system",
    "tao-ui",
    "oklch"
  ],
  "author": "rickyshin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyshin93/tao-ui.git"
  },
  "homepage": "https://github.com/rickyshin93/tao-ui#readme",
  "bugs": "https://github.com/rickyshin93/tao-ui/issues",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "build:storybook": "storybook build",
    "check": "biome check --write",
    "dev": "rslib --watch",
    "doc": "rspress dev",
    "doc:build": "rspress build",
    "doc:preview": "rspress preview",
    "format": "biome format --write",
    "storybook": "storybook dev",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@rsbuild/core": "~2.0.6",
    "@rsbuild/plugin-babel": "^1.1.2",
    "@rsbuild/plugin-react": "^2.0.0",
    "@rslib/core": "^0.21.5",
    "@rspress/core": "^2.0.11",
    "@rspress/plugin-api-docgen": "^2.0.11",
    "@rspress/plugin-preview": "^2.0.11",
    "@rstest/adapter-rslib": "^0.2.2",
    "@rstest/core": "^0.9.10",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rsbuild-plugin-workspace-dev": "^0.1.4",
    "storybook": "^10.3.6",
    "storybook-addon-rslib": "^3.3.3",
    "storybook-react-rsbuild": "^3.3.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "dayjs": ">=1.11.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
