{
  "name": "@rockshin/tao-ui",
  "version": "0.0.35",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "description": "A modern React component library with semantic DOM customization and OKLCH-based theming.",
  "keywords": [
    "react",
    "react19",
    "react18",
    "component-library",
    "ui",
    "design-system",
    "tao-ui",
    "oklch"
  ],
  "author": "rickyshin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyshin93/tao-ui.git"
  },
  "homepage": "https://github.com/rickyshin93/tao-ui#readme",
  "bugs": "https://github.com/rickyshin93/tao-ui/issues",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./src/index.tsx",
    "./dist/entries/*.js",
    "./src/entries/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./meta": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js"
    },
    "./tokens": {
      "types": "./dist/theme/tokens.d.ts",
      "import": "./dist/theme/tokens.js"
    },
    "./*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/entries/*.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "component-manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "rslib",
    "build:storybook": "storybook build",
    "check": "biome check --write",
    "check:components": "node scripts/check-component-sync.mjs",
    "dev": "rslib --watch",
    "doc": "rspress dev",
    "doc:build": "rspress build",
    "doc:preview": "rspress preview",
    "docs:generate": "node scripts/generate-component-manifest.mjs",
    "docs:check": "node scripts/generate-component-manifest.mjs --check",
    "format": "biome format --write",
    "lint": "biome lint --error-on-warnings src tests stories scripts",
    "release": "bun scripts/release.mjs",
    "storybook": "storybook dev",
    "test": "rstest",
    "test:types": "tsc --noEmit --project tsconfig.type-tests.json && tsc --noEmit --project tsconfig.type-tests.react18.json",
    "test:watch": "rstest --watch",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:package": "bun scripts/check-package-exports.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@rsbuild/core": "^2.0.11",
    "@rsbuild/plugin-babel": "^1.2.1",
    "@rsbuild/plugin-react": "^2.0.1",
    "@rslib/core": "^0.23.2",
    "@rspress/core": "^2.0.19",
    "@rspress/plugin-api-docgen": "^2.0.19",
    "@rspress/plugin-preview": "^2.0.19",
    "@rstest/adapter-rslib": "^0.10.6",
    "@rstest/core": "^0.10.6",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-onboarding": "^10.5.3",
    "@storybook/react": "^10.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/react-dom18": "npm:@types/react-dom@18",
    "@types/react18": "npm:@types/react@18",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dom18": "npm:react-dom@18.2.0",
    "react18": "npm:react@18.2.0",
    "rsbuild-plugin-workspace-dev": "^1.0.0",
    "storybook": "^10.5.3",
    "storybook-addon-rslib": "^3.3.4",
    "storybook-react-rsbuild": "^3.3.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@rc-component/form": "~1.8.5",
    "dayjs": "^1.11.21",
    "react-compiler-runtime": "^1.0.0"
  }
}
