{
  "name": "@rockshin/tao-ui",
  "version": "0.0.14",
  "type": "module",
  "description": "A modern React 19 component library with semantic DOM customization and OKLCH-based theming.",
  "keywords": [
    "react",
    "react19",
    "component-library",
    "ui",
    "design-system",
    "tao-ui",
    "oklch"
  ],
  "author": "rickyshin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyshin93/tao-ui.git"
  },
  "homepage": "https://github.com/rickyshin93/tao-ui#readme",
  "bugs": "https://github.com/rickyshin93/tao-ui/issues",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./src/index.tsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "component-manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "rslib",
    "build:storybook": "storybook build",
    "check": "biome check --write",
    "check:components": "node scripts/check-component-sync.mjs",
    "dev": "rslib --watch",
    "doc": "rspress dev",
    "doc:build": "rspress build",
    "doc:preview": "rspress preview",
    "docs:generate": "node scripts/generate-component-manifest.mjs",
    "format": "biome format --write",
    "release": "bun scripts/release.mjs",
    "storybook": "storybook dev",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@rsbuild/core": "^2.0.11",
    "@rsbuild/plugin-babel": "^1.2.1",
    "@rsbuild/plugin-react": "^2.0.1",
    "@rslib/core": "^0.23.1",
    "@rspress/core": "^2.0.13",
    "@rspress/plugin-api-docgen": "^2.0.13",
    "@rspress/plugin-preview": "^2.0.13",
    "@rstest/adapter-rslib": "^0.10.3",
    "@rstest/core": "^0.10.3",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rsbuild-plugin-workspace-dev": "^1.0.0",
    "storybook": "^10.3.6",
    "storybook-addon-rslib": "^3.3.4",
    "storybook-react-rsbuild": "^3.3.4",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "dayjs": ">=1.11.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.13",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-virtual": "^3.14.2",
    "dayjs": "^1.11.21"
  }
}
