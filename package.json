{
  "name": "tao-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "Monorepo: @rockshin/tao-ui component library and @rockshin/tao-icons icon set.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:tao-ui && bun run build:icons",
    "build:tao-ui": "bun run --filter @rockshin/tao-ui build",
    "build:icons": "bun run --filter @rockshin/tao-icons build",
    "dev": "bun run --filter @rockshin/tao-ui dev",
    "lint": "bun run --filter @rockshin/tao-ui lint",
    "format": "bun run --filter @rockshin/tao-ui format",
    "typecheck": "bun run --filter @rockshin/tao-ui typecheck",
    "test": "bun run --filter @rockshin/tao-ui test",
    "test:types": "bun run --filter @rockshin/tao-ui test:types",
    "test:package": "bun run --filter @rockshin/tao-ui test:package",
    "check:components": "bun run --filter @rockshin/tao-ui check:components",
    "docs:generate": "bun run --filter @rockshin/tao-ui docs:generate",
    "docs:check": "bun run --filter @rockshin/tao-ui docs:check",
    "doc": "bun run --filter @rockshin/tao-ui doc",
    "doc:build": "bun run --filter @rockshin/tao-ui doc:build",
    "storybook": "bun run --filter @rockshin/tao-ui storybook",
    "build:storybook": "bun run --filter @rockshin/tao-ui build:storybook",
    "release": "cd packages/tao-ui && bun scripts/release.mjs",
    "icons:generate": "bun run --filter @rockshin/tao-icons generate",
    "icons:check": "bun run --filter @rockshin/tao-icons check",
    "icons:test": "bun run --filter @rockshin/tao-icons test",
    "icons:verify": "bun run --filter @rockshin/tao-icons check:extended",
    "release:icons": "cd packages/icons && node scripts/release-guard.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
